CONFIG_DEVICE_TREE_INCLUDES="k3-am62l3-evm-hdmi-u-boot.dtso"
CONFIG_SPL_MAX_SIZE=0x80000
CONFIG_SPL_SIZE_LIMIT=0x80000
CONFIG_SPL_PAD_TO=0x0
CONFIG_SPL_BSS_START_ADDR=0x82c80000
CONFIG_SPL_BSS_MAX_SIZE=0x20000
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x820C0000
CONFIG_SPL_BOARD_INIT=y
CONFIG_SPL_GZIP=y
